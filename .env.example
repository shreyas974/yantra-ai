APP_URL="http://127.0.0.1:3000"
# Local development only. Start the Firestore emulator before running the app.
FIREBASE_PROJECT_ID="demo-yantra"
FIRESTORE_DATABASE_ID="(default)"
FIRESTORE_NAMESPACE="yantra"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# Production: remove FIRESTORE_EMULATOR_HOST, use your real project ID,
# and configure one server-only credential source. Never commit credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""
# Vercel production can use keyless Google Workload Identity Federation.
# Configure the provider to trust only your exact production project subject.
GCP_WORKLOAD_IDENTITY_AUDIENCE=""
GCP_SERVICE_ACCOUNT_EMAIL=""
FIREBASE_STORAGE_BUCKET=""
FIRESTORE_QUERY_SCAN_LIMIT="5000"
# Local mail is written to private ignored work/mail files.
# Production uses Firebase built-in verification/reset emails.
# Leave auth variables empty only for the local legacy email-file demo.
FIREBASE_AUTH_PROJECT_ID=""
FIREBASE_AUTH_API_KEY=""
INITIAL_ADMIN_EMAIL=""
# Additional organizer-approved addresses, promoted once after Firebase verifies ownership.
ADMIN_EMAILS=""
GCP_SERVICE_ACCOUNT_PROJECT_ID=""
# Optional legacy transactional email transport.
EMAIL_MODE="file"
RESEND_API_KEY=""
EMAIL_FROM=""
CRON_SECRET=""
TRUST_PROXY="false"
DEMO_PORT="3000"
