# Database URL (PostgreSQL)
DATABASE_URL="postgresql://chad:YOUR_PASSWORD@127.0.0.1:55432/chad?schema=public"

# Public application base URL
APP_URL="http://localhost:3000"

# Email mode: "file" writes transactional JSON emails to work/mail/
# In production, set to "smtp" or your transactional email provider
EMAIL_MODE="file"

# Secret token for background scheduled cron jobs
CRON_SECRET="your-random-32-byte-hex-secret"

# Proxy trust header handling
TRUST_PROXY="false"

# Test mode flag
CHAD_TEST_MODE="false"
