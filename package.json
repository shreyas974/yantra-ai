{
  "name": "yantra-ai",
  "version": "1.0.0",
  "private": true,
  "description": "YANTRA AI — AI & Machine Learning Hackathon",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "npm run build && npm run db:seed",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env scripts/test-database.mjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:promote": "node --env-file-if-exists=.env --import tsx scripts/admin-promote.ts",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-database.mjs --e2e",
    "demo": "node scripts/local-demo.mjs",
    "storage:report": "node --env-file-if-exists=.env --import tsx scripts/storage-report.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "jose": "^6.2.17",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
